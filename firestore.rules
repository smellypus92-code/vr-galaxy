rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'highScore']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'highScore', 'maxCombo', 'totalKills', 'deflections', 'shardsSliced', 'selectedChampion', 'unlockedAchievements', 'credits', 'unlockedExclusiveBadges', 'dailyMissionsState', 'admobConfig', 'reticleStyle', 'reticleIdleColor', 'reticleTargetColor', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.highScore is number && data.highScore >= 0 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('maxCombo' in data) || (data.maxCombo is number && data.maxCombo >= 0)) &&
             (!('totalKills' in data) || (data.totalKills is number && data.totalKills >= 0)) &&
             (!('deflections' in data) || (data.deflections is number && data.deflections >= 0)) &&
             (!('shardsSliced' in data) || (data.shardsSliced is number && data.shardsSliced >= 0)) &&
             (!('selectedChampion' in data) || (data.selectedChampion is string && data.selectedChampion.size() <= 50)) &&
             (!('unlockedAchievements' in data) || (data.unlockedAchievements is list && data.unlockedAchievements.size() <= 60)) &&
             (!('credits' in data) || (data.credits is number && data.credits >= 0)) &&
             (!('unlockedExclusiveBadges' in data) || (data.unlockedExclusiveBadges is list && data.unlockedExclusiveBadges.size() <= 40)) &&
             (!('dailyMissionsState' in data) || (data.dailyMissionsState is string && data.dailyMissionsState.size() <= 3000)) &&
             (!('admobConfig' in data) || (data.admobConfig is string && data.admobConfig.size() <= 2000)) &&
             (!('reticleStyle' in data) || (data.reticleStyle is string && data.reticleStyle.size() <= 30)) &&
             (!('reticleIdleColor' in data) || (data.reticleIdleColor is string && data.reticleIdleColor.size() <= 20)) &&
             (!('reticleTargetColor' in data) || (data.reticleTargetColor is string && data.reticleTargetColor.size() <= 20));
    }

    // Validation for LeaderboardEntry
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['uid', 'displayName', 'score', 'wave']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'score', 'wave', 'maxCombo', 'champion', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.score is number && data.score >= 0 &&
             data.wave is number && data.wave >= 1 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('maxCombo' in data) || (data.maxCombo is number && data.maxCombo >= 0)) &&
             (!('champion' in data) || (data.champion is string && data.champion.size() <= 50));
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection, users only read their own doc via get
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // Public Leaderboard Collection
    match /leaderboard/{entryId} {
      allow read: if true; // Public view of high scores
      allow create: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(incoming());
      allow update, delete: if false; // Immutable high scores
    }
  }
}
